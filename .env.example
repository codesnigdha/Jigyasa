# =====================================================
# DATABASE
# =====================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jigyasa
DB_USER=root
DB_PASSWORD=your_mysql_password

# =====================================================
# JWT AUTHENTICATION
# =====================================================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================
# AZURE OPENAI - LAB 3 & LAB 4
# =====================================================
AZURE_OPENAI_ENDPOINT_LAB=your_azure_openai_endpoint_lab
MODEL_DEPLOYMENT_LAB3=gpt-5.2

# =====================================================
# AZURE CONTENT UNDERSTANDING - LAB 20
# =====================================================
CONTENT_UNDERSTANDING_ENDPOINT=your_azure_openai_endpoint_lab
CONTENT_UNDERSTANDING_ANALYZER=jigyasa
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01



ENDPOINT=your-azure-image-endpoint
MODEL_DEPLOYMENT=your-image-model-deployment